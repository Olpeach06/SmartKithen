<Page x:Class="SmartKithen.Pages.RecipeHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="RecipeHistory"
      Background="#FFF8FC">

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="20">

                <!-- Шапка -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="← Назад"
                            FontSize="14"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#1A5D34"
                            Padding="10,5"
                            Click="btnBack_Click"/>

                    <TextBlock Grid.Column="1"
                               Text="🕐 История просмотров"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#1A5D34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Кнопка очистить историю -->
                    <Border Grid.Column="2"
                            BorderBrush="#CFA1C1" BorderThickness="1"
                            CornerRadius="10">
                        <Button Content="Очистить"
                                FontSize="12"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#CFA1C1"
                                Padding="12,6"
                                Click="btnClearHistory_Click"/>
                    </Border>
                </Grid>

                <!-- Сюда динамически добавляем группы по дням -->
                <StackPanel x:Name="HistoryPanel" Orientation="Vertical"/>

                <!-- Заглушка если пусто -->
                <Border x:Name="EmptyState"
                        Visibility="Collapsed"
                        Background="White" CornerRadius="20"
                        Padding="40" Margin="0,20,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="48"
                                   HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Вы ещё ничего не смотрели"
                                   FontSize="16" Foreground="#999"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>