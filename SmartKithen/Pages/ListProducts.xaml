<Page x:Class="SmartKithen.Pages.ListProducts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmartKithen.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1100" d:DesignWidth="800"
      Title="ListProducts"
      Background="#FFF8FC"
      MinWidth="700"
      MinHeight="600">

    <Page.Resources>
        <!-- Стиль для кнопки назад -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A5D34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#144528"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для зеленой кнопки -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A5D34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#144528"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для вторичной кнопки -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1A5D34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#CFA1C1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF0F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для пустого состояния -->
        <Style x:Key="EmptyStateStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Фоновый градиент -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" 
                        HorizontalAlignment="Center"
                        Width="700"
                        Margin="40,20">

                <!-- Шапка -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Навигация -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center">
                        <Button x:Name="BackButton"
                                Content="← Назад" 
                                Style="{StaticResource BackButtonStyle}"
                                Padding="15,8"
                                Click="BackButton_Click"/>
                        <TextBlock Text="Мои списки > Текущий" 
                                   FontSize="14" 
                                   Foreground="#666"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Правые элементы -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center">

                        <!-- Профиль -->
                        <Border x:Name="ProfileBorder"
                                Background="#1A5D34" 
                                CornerRadius="15" 
                                Padding="12,8"
                                Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍳" 
                                           FontSize="14"
                                           Foreground="White"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="UserNameText"
                                           Text="Загрузка..." 
                                           FontSize="12" 
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Экспорт -->
                        <Border Background="#1A5D34" 
                                CornerRadius="8"
                                Padding="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                            </Border.Effect>
                            <Button x:Name="ExportButton"
                                    Content="📤 Экспорт" 
                                    FontSize="13"
                                    Background="Transparent" 
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="15,10"
                                    Click="ExportButton_Click"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Секция выбора рецептов (ТОЛЬКО ДЛЯ АВТОРИЗОВАННЫХ) -->
                <Border x:Name="RecipesSection"
                        Background="White" 
                        CornerRadius="20" 
                        Padding="30,25" 
                        Margin="0,0,0,25"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="Выберите рецепты" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#1A5D34"
                                   Margin="0,0,0,20"/>

                        <!-- Список рецептов -->
                        <StackPanel x:Name="RecipesPanel" Orientation="Vertical"/>

                        <!-- Пустое состояние для рецептов -->
                        <Border x:Name="EmptyRecipesState"
                                Style="{StaticResource EmptyStateStyle}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="📖" 
                                           FontSize="48" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="У вас пока нет рецептов" 
                                           FontSize="16" 
                                           FontWeight="SemiBold"
                                           Foreground="#1A5D34"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Добавьте рецепты в избранное, чтобы формировать список покупок"
                                           FontSize="13"
                                           Foreground="#666"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,0,0,15"/>
                                <Button Content="🔍 Найти рецепты"
                                        Style="{StaticResource GreenButtonStyle}"
                                        Padding="20,10"
                                        HorizontalAlignment="Center"
                                        Click="AddRecipeButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Кнопка генерации -->
                        <Button x:Name="GenerateForSelectedButton"
                                Content="🤖 Добавить недостающие продукты"
                                Style="{StaticResource GreenButtonStyle}"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                Padding="25,12"
                                Click="GenerateForSelectedButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Секция списка покупок -->
                <Border Background="White" 
                        CornerRadius="20" 
                        Padding="30,25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="🛒 Список покупок" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#1A5D34"/>
                            <TextBlock x:Name="ItemsCountText" 
                                       Text="(0 позиций)" 
                                       FontSize="14" 
                                       Foreground="#CFA1C1"
                                       FontWeight="Medium"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Контейнеры для категорий продуктов -->
                        <StackPanel x:Name="MeatFishPanel" Orientation="Vertical"/>
                        <StackPanel x:Name="DairyPanel" Orientation="Vertical"/>
                        <StackPanel x:Name="VegFruitPanel" Orientation="Vertical"/>
                        <StackPanel x:Name="OtherPanel" Orientation="Vertical"/>

                        <!-- Пустое состояние для продуктов -->
                        <Border x:Name="EmptyProductsState"
                                Style="{StaticResource EmptyStateStyle}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="🛒" 
                                           FontSize="48" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,15"/>
                                <TextBlock x:Name="EmptyProductsTitle"
                                           Text="Список покупок пуст" 
                                           FontSize="16" 
                                           FontWeight="SemiBold"
                                           Foreground="#1A5D34"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="EmptyProductsMessage"
                                           Text="Добавьте продукты из рецептов или нажмите «Добавить продукт»"
                                           FontSize="13"
                                           Foreground="#666"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Кнопки управления -->
                        <StackPanel x:Name="ActionButtonsPanel"
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,25,0,0"
                                    Visibility="Collapsed">

                            <!-- Кнопка добавления продукта -->
                            <Border Background="#1A5D34" 
                                    CornerRadius="8"
                                    Margin="0,0,10,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="3"/>
                                </Border.Effect>
                                <Button x:Name="AddProductButton"
                                        Content="➕ Добавить продукт" 
                                        FontSize="13"
                                        Background="Transparent" 
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="25,12"
                                        Click="AddProductButton_Click"/>
                            </Border>

                            <Border BorderBrush="#CFA1C1" 
                                    BorderThickness="2" 
                                    CornerRadius="8">
                                <Button x:Name="ClearCheckedButton"
                                        Content="🗑️ Очистить отмеченные" 
                                        FontSize="13"
                                        Background="Transparent" 
                                        Foreground="#1A5D34"
                                        BorderThickness="0"
                                        Padding="25,12"
                                        Click="ClearCheckedButton_Click"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>