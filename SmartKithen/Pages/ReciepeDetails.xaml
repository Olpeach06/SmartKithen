<Page x:Class="SmartKithen.Pages.RecipeDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmartKithen.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1330" d:DesignWidth="800"
      Title="RecipeDetails"
      Background="#FFF8FC">

    <Grid>
        <!-- Фоновый градиент -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Шапка с навигацией -->
                <Grid Margin="20,20,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка Назад -->
                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Content="← Назад" 
                            FontSize="14"
                            Background="Transparent" 
                            BorderThickness="0"
                            Foreground="#1A5D34"
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            Click="BackButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#CFA1C1"/>
                                        <Setter Property="Background" Value="#FFF0F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Поиск и навигация -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <Button x:Name="SearchButton"
                                Content="🔍" 
                                Background="Transparent" 
                                BorderThickness="0"
                                FontSize="16"
                                Padding="5"
                                Cursor="Hand"
                                Click="SearchButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#CFA1C1"/>
                                            <Setter Property="Background" Value="#FFF0F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="NextButton"
                                Content="→" 
                                Background="Transparent" 
                                BorderThickness="0"
                                FontSize="16"
                                Padding="5"
                                Margin="5,0,0,0"
                                Cursor="Hand"
                                Click="NextButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#CFA1C1"/>
                                            <Setter Property="Background" Value="#FFF0F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="MenuButton"
                                Content="⋮" 
                                Background="Transparent" 
                                BorderThickness="0"
                                FontSize="16"
                                Padding="5"
                                Margin="5,0,0,0"
                                Cursor="Hand"
                                Click="MenuButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#CFA1C1"/>
                                            <Setter Property="Background" Value="#FFF0F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Кнопка "В готовку" -->
                    <Border Grid.Column="4"
                            Background="#1A5D34" 
                            CornerRadius="12"
                            Padding="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                        </Border.Effect>
                        <Button x:Name="StartCookingButton"
                                Content="В готовку" 
                                FontSize="12"
                                FontWeight="SemiBold"
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,8"
                                Cursor="Hand"
                                Click="StartCookingButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>
                </Grid>

                <!-- Изображение рецепта (заглушка) -->
                <Border Height="250" 
                        Background="#F8F9FA" 
                        Margin="20,20,20,0"
                        CornerRadius="20"
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock x:Name="RecipeImagePlaceholder" 
                                   Text="🍝" 
                                   FontSize="80" 
                                   Foreground="#999"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Основная информация -->
                <Border Background="White" 
                        CornerRadius="20" 
                        Margin="20,20,20,0"
                        Padding="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">

                        <!-- Название рецепта (динамическое) -->
                        <TextBlock x:Name="RecipeTitleText" 
                                   Text="ЗАГРУЗКА..." 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#1A5D34"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <!-- Время и порции -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" 
                                        HorizontalAlignment="Center">
                                <TextBlock Text="🕐" 
                                           FontSize="18"
                                           Foreground="#666"/>
                                <TextBlock x:Name="CookingTimeText" 
                                           Text="-- мин" 
                                           FontSize="14" 
                                           Foreground="#666"
                                           FontWeight="Medium"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" 
                                        HorizontalAlignment="Center">
                                <TextBlock Text="🍽️" 
                                           FontSize="18"
                                           Foreground="#666"/>
                                <TextBlock x:Name="ServingsText" 
                                           Text="2 порции" 
                                           FontSize="14" 
                                           Foreground="#666"
                                           FontWeight="Medium"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" 
                                        HorizontalAlignment="Center">
                                <TextBlock Text="⚡" 
                                           FontSize="18"
                                           Foreground="#666"/>
                                <TextBlock x:Name="DifficultyText" 
                                           Text="Средняя" 
                                           FontSize="14" 
                                           Foreground="#666"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Grid>

                        <!-- Рейтинг (можно сделать динамическим) -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,15">
                            <TextBlock x:Name="RatingStars" 
                                       Text="★★★★☆" 
                                       FontSize="18" 
                                       Foreground="#FFB800"
                                       Margin="0,0,5,0"/>
                            <TextBlock x:Name="RatingValueText" 
                                       Text="4.5" 
                                       FontSize="14" 
                                       Foreground="#666"/>
                        </StackPanel>

                        <!-- Описание рецепта (динамическое) -->
                        <TextBlock x:Name="RecipeDescriptionText" 
                                   Text="Загрузка описания..." 
                                   FontSize="16" 
                                   Foreground="#555"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,0,0,20"/>

                        <!-- Кнопка добавления в список покупок -->
                        <Border Background="#FFA500" 
                                CornerRadius="12"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="3"/>
                            </Border.Effect>
                            <Button x:Name="AddToShoppingListButton"
                                    Content="Добавить в список покупок" 
                                    FontSize="14" 
                                    FontWeight="SemiBold"
                                    Background="Transparent" 
                                    Foreground="White" 
                                    BorderThickness="0"
                                    Padding="25,12"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    Click="AddToShoppingListButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Ингредиенты -->
                <Border Background="White" 
                        CornerRadius="20" 
                        Margin="20,20,20,0"
                        Padding="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="📝 ИНГРЕДИЕНТЫ" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#1A5D34"
                                   Margin="0,0,0,20"/>

                        <Border Background="#F8F9FA" 
                                CornerRadius="15" 
                                Padding="20,15">
                            <!-- ДИНАМИЧЕСКАЯ ПАНЕЛЬ ДЛЯ ИНГРЕДИЕНТОВ -->
                            <StackPanel x:Name="IngredientsPanel" 
                                        Orientation="Vertical"/>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Шаги приготовления -->
                <Border Background="White" 
                        CornerRadius="20" 
                        Margin="20,20,20,20"
                        Padding="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="👩‍🍳 ШАГИ ПРИГОТОВЛЕНИЯ" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#1A5D34"
                                   Margin="0,0,0,20"/>

                        <!-- ДИНАМИЧЕСКАЯ ПАНЕЛЬ ДЛЯ ШАГОВ -->
                        <StackPanel x:Name="StepsPanel" 
                                    Orientation="Vertical"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>