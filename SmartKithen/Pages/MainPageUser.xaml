<Page x:Class="SmartKithen.Pages.MainPageUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="800"
      Title="MainPageUser"
      Background="#FFF8FC">

    <Page.Resources>
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF0F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="20">

                <!-- Шапка -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="15" 
                            Padding="15,10"
                            HorizontalAlignment="Left">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🍳" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Smart Kitchen" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="#1A5D34"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Иконки -->
                        <Button x:Name="btnSearch"
                            Style="{StaticResource MainButtonStyle}"
                            Background="White"
                            Padding="10"
                            Margin="0,0,10,0"
                            Cursor="Hand" Click="btnSearch_Click">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Button.Effect>
                            <TextBlock Text="🔍" 
                               FontSize="16" 
                               Foreground="#1A5D34"/>
                        </Button>

                        <Border Background="White" CornerRadius="10" Padding="10"
                                Margin="0,0,10,0" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <TextBlock Text="🔔" FontSize="16" Foreground="#1A5D34"/>
                        </Border>

                        <Border Background="#1A5D34" CornerRadius="12" Padding="12,8" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="12" Margin="0,0,8,0" Foreground="White"/>
                                <!-- ИМЯ В ШАПКЕ -->
                                <TextBlock x:Name="UserNameText"
                                           Text="..." 
                                           FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnSettingUser"
                                Style="{StaticResource MainButtonStyle}"
                                Background="White" Padding="10" Margin="10,0,10,0"
                                Click="btnSettingUser_Click">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Button.Effect>
                            <TextBlock Text="⚙️" FontSize="16" Foreground="#1A5D34"/>
                        </Button>

                        <Border x:Name="SwitchAccountBorder"
                                Background="White" CornerRadius="10" Padding="10"
                                Margin="0,0,10,0" Cursor="Hand"
                                MouseLeftButtonDown="SwitchAccountBorder_Click">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <TextBlock Text="🚪 Выйти" FontSize="16" Foreground="#1A5D34"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ПРИВЕТСТВИЕ -->
                <Border Background="White" CornerRadius="15" Padding="25,20" Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>
                    <TextBlock x:Name="WelcomeText"
                               Text="Добро пожаловать на вашу умную кухню!" 
                               FontSize="18" FontWeight="SemiBold" 
                               Foreground="#1A5D34" TextAlignment="Center"/>
                </Border>

                <!-- Карточки навигации -->
                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,30" HorizontalAlignment="Stretch">

                    <Border Background="White" CornerRadius="15" Padding="20" Margin="5"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <Button x:Name="btnRecipes" Style="{StaticResource CardButtonStyle}" Click="btnRecipes_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="📖" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Мои рецепты" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#1A5D34" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <!-- СЧЁТЧИК РЕЦЕПТОВ -->
                                <TextBlock x:Name="TotalRecipesCount"
                                           Text="..." 
                                           FontSize="20" FontWeight="Bold" 
                                           Foreground="#CFA1C1" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Background="White" CornerRadius="15" Padding="20" Margin="5"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <Button x:Name="btnShoppingList" Style="{StaticResource CardButtonStyle}" Click="btnShoppingList_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="🛒" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Список покупок" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#1A5D34" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Background="White" CornerRadius="15" Padding="20" Margin="5"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <Button x:Name="btnMyProducts" Style="{StaticResource CardButtonStyle}" Click="btnMyProducts_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="🥦" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Мои продукты" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#1A5D34" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Background="White" CornerRadius="15" Padding="20" Margin="5"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <Button x:Name="btnRandomRecipe" Style="{StaticResource CardButtonStyle}" Click="btnRandomRecipe_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="🎲" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Случайный рецепт" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#1A5D34" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </UniformGrid>

                <!-- Статистика и уведомления -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- СТАТИСТИКА -->
                    <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="20"
                            Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="📊 Быстрая статистика" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#1A5D34" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Любимых рецептов:" FontSize="13" Foreground="#666"/>
                                <!-- ИЗБРАННЫЕ -->
                                <TextBlock x:Name="FavoriteRecipesCount"
                                           Text="..." 
                                           FontSize="13" FontWeight="Bold" 
                                           Foreground="#CFA1C1" Margin="5,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Продуктов отслеживается:" FontSize="13" Foreground="#666"/>
                                <!-- ПРОДУКТЫ В ХОЛОДИЛЬНИКЕ -->
                                <TextBlock x:Name="TrackedProductsCount"
                                           Text="..." 
                                           FontSize="13" FontWeight="Bold" 
                                           Foreground="#CFA1C1" Margin="5,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Просмотрено рецептов:" FontSize="13" Foreground="#666"/>
                                <!-- ИСТОРИЯ ПРОСМОТРОВ -->
                                <TextBlock x:Name="ViewedRecipesCount"
                                           Text="..." 
                                           FontSize="13" FontWeight="Bold" 
                                           Foreground="#CFA1C1" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- УВЕДОМЛЕНИЯ -->
                    <Border Grid.Column="1" Background="#FFF8FC" CornerRadius="15" Padding="20"
                            Margin="10,0,0,0" BorderBrush="#CFA1C1" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="⚠️ Срочные уведомления" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#1A5D34" Margin="0,0,0,15"/>
                            <!-- ДИНАМИЧЕСКИЕ УВЕДОМЛЕНИЯ -->
                            <StackPanel x:Name="NotificationsPanel" Orientation="Vertical"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- НЕДАВНИЕ РЕЦЕПТЫ -->
                <Border Background="White" CornerRadius="15" Padding="25"
                        Margin="0,0,0,30" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">

                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Недавние рецепты" FontSize="18" FontWeight="Bold" 
                                       Foreground="#1A5D34" VerticalAlignment="Center"/>
                            <Border x:Name="btnShowAllRecipes"
                                    Background="#1A5D34" CornerRadius="8" Padding="12,8"
                                    HorizontalAlignment="Right" Cursor="Hand"
                                    MouseLeftButtonDown="btnShowAllRecipes_Click">
                                <TextBlock Text="Показать все" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- СПИСОК НЕДАВНИХ -->
                        <StackPanel x:Name="RecentRecipesPanel" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- РЕКОМЕНДАЦИИ -->
                <Border Background="White" CornerRadius="15" Padding="25"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Рекомендуем приготовить" FontSize="18" FontWeight="Bold" 
                                   Foreground="#1A5D34" Margin="0,0,0,20"/>
                        <!-- СПИСОК РЕКОМЕНДАЦИЙ -->
                        <StackPanel x:Name="RecommendationsPanel" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>