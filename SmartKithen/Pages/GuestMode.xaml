<Page x:Class="SmartKithen.Pages.GuestMode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmartKithen.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="800"
      Title="GuestMode"
      Background="#FFF8FC">

    <Page.Resources>
        <!-- Стиль для основных кнопок -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для навигационных кнопок -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A5D34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A7A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Фон с градиентом -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="20">

                <!-- Шапка -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка назад -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="15" 
                            Padding="15,10"
                            HorizontalAlignment="Left">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <Button x:Name="btnBack"
                                Content="← Назад"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#1A5D34"
                                Padding="10,5"
                                Click="btnBack_Click"/>
                    </Border>

                    <!-- Заголовок по центру -->
                    <TextBlock Grid.Column="1"
                               Text="👑 Гостевой режим"
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#1A5D34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Статистика -->
                    <Border Grid.Column="2"
                            Background="White" 
                            CornerRadius="15" 
                            Padding="15,10"
                            HorizontalAlignment="Right">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" 
                                       FontSize="20" 
                                       Margin="0,0,10,0"/>
                            <TextBlock x:Name="StatsText" 
                                       Text="Вы создали 0 рецептов" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1A5D34"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Основной контент -->
                <Border Background="White" 
                        CornerRadius="15" 
                        Padding="40"
                        Margin="0,50,0,30"
                        HorizontalAlignment="Center"
                        Width="500"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="8"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical" 
                                HorizontalAlignment="Center">

                        <!-- Иконка гостя -->
                        <Border Background="#FFF8FC" 
                                CornerRadius="20" 
                                Padding="25"
                                Margin="0,0,0,30"
                                BorderBrush="#CFA1C1"
                                BorderThickness="2"
                                Width="100"
                                Height="100">
                            <StackPanel Orientation="Vertical" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="👑" 
                                           FontSize="20" 
                                           Width="31"/>
                                <TextBlock Text="👤" 
                                           FontSize="30"
                                           Margin="0,0,0,5" 
                                           Height="31"/>
                            </StackPanel>
                        </Border>

                        <!-- Заголовок -->
                        <TextBlock Text="Привет, Гость!" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="#1A5D34"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <!-- Подзаголовок -->
                        <TextBlock Text="Вы работаете в гостевом режиме" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#666"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,30"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Преимущества регистрации -->
                <Border Background="White" 
                        CornerRadius="15" 
                        Padding="30"
                        Margin="0,0,0,30"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="✨ Зарегистрируйтесь, чтобы получить:" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#1A5D34"
                                   Margin="0,0,0,25"/>

                        <!-- Список преимуществ -->
                        <StackPanel Orientation="Vertical" 
                                    Margin="0,0,0,20">

                            <!-- Преимущество 1 - Сохранение рецептов -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Иконка -->
                                <Border Grid.Column="0"
                                        Background="#FFF8FC" 
                                        CornerRadius="8" 
                                        Padding="10"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,15,0">
                                    <TextBlock Text="📝" 
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Текст -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Сохранить все рецепты" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="#1A5D34"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Ваши рецепты останутся с вами навсегда" 
                                               FontSize="13" 
                                               Foreground="#666"/>
                                </StackPanel>
                            </Grid>

                            <!-- Преимущество 2 - Добавление продуктов в холодильник -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Иконка -->
                                <Border Grid.Column="0"
                                        Background="#FFF8FC" 
                                        CornerRadius="8" 
                                        Padding="10"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,15,0">
                                    <TextBlock Text="🧊" 
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Текст -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Управление холодильником" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="#1A5D34"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Добавляйте продукты в свой холодильник" 
                                               FontSize="13" 
                                               Foreground="#666"/>
                                </StackPanel>
                            </Grid>

                            <!-- Преимущество 3 - Отслеживание сроков годности -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Иконка -->
                                <Border Grid.Column="0"
                                        Background="#FFF8FC" 
                                        CornerRadius="8" 
                                        Padding="10"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,15,0">
                                    <TextBlock Text="⏰" 
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Текст -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Контроль сроков годности" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="#1A5D34"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Никаких просроченных продуктов" 
                                               FontSize="13" 
                                               Foreground="#666"/>
                                </StackPanel>
                            </Grid>

                            <!-- Преимущество 4 - Умные уведомления -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Иконка -->
                                <Border Grid.Column="0"
                                        Background="#FFF8FC" 
                                        CornerRadius="8" 
                                        Padding="10"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,15,0">
                                    <TextBlock Text="🔔" 
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Текст -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Умные уведомления" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="#1A5D34"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="О скорой порче продуктов и новых рецептах" 
                                               FontSize="13" 
                                               Foreground="#666"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Кнопки действий -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Продолжить как гость -->
                    <Button Grid.Column="0"
                            x:Name="ContinueGuestButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Background="White"
                            Foreground="#1A5D34"
                            BorderBrush="#1A5D34"
                            BorderThickness="1"
                            Margin="0,0,10,0"
                            Click="ContinueGuestButton_Click">
                        <TextBlock Text="👤 Продолжить как гость" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"/>
                    </Button>

                    <!-- Сохранить прогресс -->
                    <Button Grid.Column="1"
                            x:Name="SaveProgressButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Background="#CFA1C1"
                            Margin="10,0,0,0"
                            Click="SaveProgressButton_Click">
                        <TextBlock Text="💾 Сохранить прогресс" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"/>
                    </Button>
                </Grid>

                <!-- Примечание о приватности -->
                <Border Background="#FFF8FC" 
                        CornerRadius="10" 
                        Padding="20"
                        Margin="0,0,0,20"
                        BorderBrush="#CFA1C1"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <TextBlock Text="🔒" 
                                   FontSize="16"
                                   Margin="0,0,10,0"
                                   Foreground="#1A5D34"/>
                        <TextBlock Text="Регистрация займет всего 2 минуты. Мы не передаем ваши данные третьим лицам." 
                                   FontSize="13" 
                                   Foreground="#666"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="18"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>