<Page x:Class="SmartKithen.Pages.CreatingGuestReciepe"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmartKithen.Pages"
       mc:Ignorable="d" 
      d:DesignHeight="1050" d:DesignWidth="800"
      Title="CreatingGuestRecipe"
      Background="#FFF8FC">

    <Page.Resources>
        <!-- Стиль для основных кнопок -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для навигационных кнопок -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A5D34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A7A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для полей ввода -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для комбобоксов -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для заголовков разделов -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A5D34"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Фон с градиентом -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="20">

                <!-- Шапка -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка назад -->
                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Style="{StaticResource MainButtonStyle}"
                            Click="BackButton_Click">
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="15,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="←" 
                                           FontSize="18" 
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Назад" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#1A5D34"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Заголовок -->
                    <Border Grid.Column="1"
                            Background="White" 
                            CornerRadius="15" 
                            Padding="20,15"
                            HorizontalAlignment="Center"
                            Width="300">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center">
                            <TextBlock Text="🍳" 
                                       FontSize="20" 
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="Новый рецепт (Гость)" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#1A5D34"/>
                        </StackPanel>
                    </Border>

                    <!-- Правые кнопки -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center">

                        <!-- Кнопка гостя -->
                        <Button x:Name="GuestModeButton"
                                Style="{StaticResource MainButtonStyle}"
                                Click="GuestModeButton_Click"
                                ToolTip="Войти или зарегистрироваться"
                                Margin="0,0,15,0">
                            <Border Background="#CFA1C1" 
                                    CornerRadius="10" 
                                    Padding="15,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="2"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" 
                                            VerticalAlignment="Center">
                                    <TextBlock Text="👤" 
                                               FontSize="16" 
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Гость" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Сохранить -->
                        <Button x:Name="SaveButton"
                                Style="{StaticResource NavigationButtonStyle}"
                                Content="💾 Сохранить"
                                Click="SaveButton_Click"/>

                    </StackPanel>
                </Grid>

                <!-- Основной контент -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВАЯ КОЛОНКА: Основная информация -->
                    <Border Grid.Column="0"
                            Background="White" 
                            CornerRadius="15" 
                            Padding="25"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical">

                            <!-- Добавить фото -->
                            <Border Background="#FFF8FC" 
                                    CornerRadius="12" 
                                    Height="180"
                                    Margin="0,0,0,25"
                                    BorderBrush="#CFA1C1"
                                    BorderThickness="1">
                                <Button x:Name="AddPhotoButton"
                                        Style="{StaticResource MainButtonStyle}"
                                        Click="AddPhotoButton_Click">
                                    <StackPanel Orientation="Vertical" 
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="📷" 
                                                   FontSize="40" 
                                                   Foreground="#CFA1C1"
                                                   Margin="0,0,0,10" Width="55"/>
                                        <TextBlock Text="Добавить фото рецепта" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#1A5D34"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- Название рецепта -->
                            <TextBlock Text="📝 Название рецепта:" 
                                       Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBox x:Name="RecipeNameTextBox"
                                     Text="Паста Карбонара" 
                                     Style="{StaticResource InputFieldStyle}"
                                     Margin="0,0,0,20"/>

                            <!-- Описание -->
                            <TextBlock Text="📄 Описание:" 
                                       Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBox x:Name="DescriptionTextBox"
                                     Text="Классическая итальянская паста с беконом и сливочным соусом..." 
                                     Style="{StaticResource InputFieldStyle}"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,20"/>

                            <!-- Детали рецепта -->
                            <TextBlock Text="⏱ Детали рецепта:" 
                                       Style="{StaticResource SectionHeaderStyle}"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Время -->
                                <Border Grid.Column="0"
                                        Background="#FFF8FC" 
                                        CornerRadius="10" 
                                        Padding="15"
                                        Margin="0,0,10,0"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="⏰ Время" 
                                                   FontSize="13" 
                                                   Foreground="#666"
                                                   Margin="0,0,0,8"/>
                                        <Grid>
                                            <TextBox 
                                                     FontSize="14" 
                                                     Padding="8"
                                                     BorderBrush="#E0E0E0" 
                                                     BorderThickness="1"
                                                     Width="60"
                                                     HorizontalAlignment="Left"/>
                                            <TextBlock Text="мин" 
                                                       FontSize="14" 
                                                       Foreground="#1A5D34"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,30,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Порции -->
                                <Border Grid.Column="1"
                                        Background="#FFF8FC" 
                                        CornerRadius="10" 
                                        Padding="15"
                                        Margin="10,0,10,0"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="👥 Порции" 
                                                   FontSize="13" 
                                                   Foreground="#666"
                                                   Margin="0,0,0,8"/>
                                        <TextBox Text="2" 
                                                 FontSize="14" 
                                                 Padding="8"
                                                 BorderBrush="#E0E0E0" 
                                                 BorderThickness="1"
                                                 Width="48"/>
                                    </StackPanel>
                                </Border>

                                <!-- Сложность -->
                                <Border Grid.Column="2"
                                        Background="#FFF8FC" 
                                        CornerRadius="10" 
                                        Padding="15"
                                        Margin="10,0,0,0"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="📈 Сложность" 
                                                   FontSize="13" 
                                                   Foreground="#666"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox SelectedIndex="1"
                                                  Style="{StaticResource ComboBoxStyle}" Width="61">
                                            <ComboBoxItem Content="★ Легкая"/>
                                            <ComboBoxItem Content="★ Средняя"/>
                                            <ComboBoxItem Content="★★ Сложная"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Категория и теги -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Категория -->
                                <Border Grid.Column="0"
                                        Background="#FFF8FC" 
                                        CornerRadius="10" 
                                        Padding="15"
                                        Margin="0,0,10,0"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="📂 Категория" 
                                                   FontSize="13" 
                                                   Foreground="#666"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox SelectedIndex="0"
                                                  Style="{StaticResource ComboBoxStyle}" FontSize="9">
                                            <ComboBoxItem Content="Основные блюда"/>
                                            <ComboBoxItem Content="Закуски"/>
                                            <ComboBoxItem Content="Десерты"/>
                                            <ComboBoxItem Content="Напитки"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Теги -->
                                <Border Grid.Column="1"
                                        Background="#FFF8FC" 
                                        CornerRadius="10" 
                                        Padding="15"
                                        Margin="10,0,0,0"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="🏷 Теги" 
                                                   FontSize="13" 
                                                   Foreground="#666"
                                                   Margin="0,0,0,8"/>
                                        <TextBox Text="паста, итальянская, сливочный" 
                                                 Style="{StaticResource InputFieldStyle}" FontSize="9"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- ПРАВАЯ КОЛОНКА: Ингредиенты и шаги -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Vertical">

                        <!-- ИНГРЕДИЕНТЫ -->
                        <Border Background="White" 
                                CornerRadius="15" 
                                Padding="25"
                                Margin="0,0,0,20"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                            </Border.Effect>
                            <StackPanel Orientation="Vertical">

                                <TextBlock Text="🥦 ИНГРЕДИЕНТЫ:" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="#1A5D34"
                                           Margin="0,0,0,20"/>

                                <!-- Список ингредиентов -->
                                <StackPanel Orientation="Vertical"
                                            Margin="0,0,0,20">

                                    <!-- Ингредиент 1 -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="0">
                                            <TextBox Text="Спагетти" 
                                                     FontSize="14" 
                                                     Padding="8"
                                                     BorderThickness="0"
                                                     Background="Transparent"/>
                                        </Border>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="1"
                                                Margin="10,0,10,0">
                                            <TextBox Text="400" 
                                                     Padding="8"
                                                     BorderThickness="0"
                                                     Background="Transparent"/>
                                        </Border>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="2">
                                            <ComboBox SelectedIndex="0"
                                                      FontSize="14" 
                                                      Padding="8"
                                                      BorderThickness="0"
                                                      Background="Transparent">
                                                <ComboBoxItem Content="г"/>
                                                <ComboBoxItem Content="мл"/>
                                                <ComboBoxItem Content="шт"/>
                                            </ComboBox>
                                        </Border>
                                    </Grid>

                                    <!-- Ингредиент 2 -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="0">
                                            <TextBox Text="Бекон" 
                                                     FontSize="14" 
                                                     Padding="8"
                                                     BorderThickness="0"
                                                     Background="Transparent"/>
                                        </Border>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="1"
                                                Margin="10,0,10,0">
                                            <TextBox Text="200" 
                                                     Padding="8"
                                                     BorderThickness="0"
                                                     Background="Transparent"/>
                                        </Border>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="2">
                                            <ComboBox SelectedIndex="0"
                                                      FontSize="14" 
                                                      Padding="8"
                                                      BorderThickness="0"
                                                      Background="Transparent">
                                                <ComboBoxItem Content="г"/>
                                                <ComboBoxItem Content="мл"/>
                                                <ComboBoxItem Content="шт"/>
                                            </ComboBox>
                                        </Border>
                                    </Grid>

                                    <!-- Ингредиент 3 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="0">
                                            <TextBox Text="Сливки" 
                                                     FontSize="14" 
                                                     Padding="8"
                                                     BorderThickness="0"
                                                     Background="Transparent"/>
                                        </Border>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="1"
                                                Margin="10,0,10,0">
                                            <TextBox Text="200" 
                                                     Padding="8"
                                                     BorderThickness="0"
                                                     Background="Transparent"/>
                                        </Border>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="2">
                                            <ComboBox SelectedIndex="1"
                                                      FontSize="14" 
                                                      Padding="8"
                                                      BorderThickness="0"
                                                      Background="Transparent" Margin="0,0,-11,0">
                                                <ComboBoxItem Content="г"/>
                                                <ComboBoxItem Content="мл"/>
                                                <ComboBoxItem Content="шт"/>
                                            </ComboBox>
                                        </Border>
                                    </Grid>

                                </StackPanel>

                                <!-- Добавить ингредиент -->
                                <Button x:Name="AddIngredientButton"
                                        Style="{StaticResource NavigationButtonStyle}"
                                        Content="➕ Добавить ингредиент"
                                        Background="#CFA1C1"
                                        HorizontalAlignment="Left"
                                        Padding="15,10"
                                        Click="AddIngredientButton_Click"/>

                            </StackPanel>
                        </Border>

                        <!-- ШАГИ ПРИГОТОВЛЕНИЯ -->
                        <Border Background="White" 
                                CornerRadius="15" 
                                Padding="25"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                            </Border.Effect>
                            <StackPanel Orientation="Vertical">

                                <TextBlock Text="👨‍🍳 ШАГИ ПРИГОТОВЛЕНИЯ:" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="#1A5D34"
                                           Margin="0,0,0,20"/>

                                <!-- Список шагов -->
                                <StackPanel Orientation="Vertical"
                                            Margin="0,0,0,20">

                                    <!-- Шаг 1 -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#1A5D34" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                Width="35"
                                                Height="35"
                                                Grid.Column="0">
                                            <TextBlock Text="1" 
                                                       FontSize="16" 
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="10" 
                                                Padding="15"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="1"
                                                Margin="10,0,0,0">
                                            <TextBox Text="Поставить воду для пасты на огонь, посолить и довести до кипения..." 
                                                     FontSize="14" 
                                                     Padding="8"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Height="80"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                    </Grid>

                                    <!-- Шаг 2 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#1A5D34" 
                                                CornerRadius="8" 
                                                Padding="10"
                                                Width="35"
                                                Height="35"
                                                Grid.Column="0">
                                            <TextBlock Text="2" 
                                                       FontSize="16" 
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFF8FC" 
                                                CornerRadius="10" 
                                                Padding="15"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Grid.Column="1"
                                                Margin="10,0,0,0">
                                            <TextBox Text="Обжарить бекон на среднем огне до хрустящей корочки, затем добавить сливки..." 
                                                     FontSize="14" 
                                                     Padding="8"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Height="80"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                    </Grid>

                                </StackPanel>

                                <!-- Добавить шаг -->
                                <Button x:Name="AddStepButton"
                                        Style="{StaticResource NavigationButtonStyle}"
                                        Content="➕ Добавить шаг"
                                        Background="#CFA1C1"
                                        HorizontalAlignment="Left"
                                        Padding="15,10"
                                        Click="AddStepButton_Click"/>

                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>

                <!-- Примечание для гостя -->
                <Border Background="#FFF8FC" 
                        CornerRadius="15" 
                        Padding="20"
                        Margin="0,30,0,0"
                        BorderBrush="#CFA1C1"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="👤" 
                                   FontSize="20"
                                   Margin="0,0,15,0"
                                   Foreground="#1A5D34"/>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Вы работаете в гостевом режиме" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="#1A5D34"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Сохраните прогресс, чтобы не потерять созданные рецепты" 
                                       FontSize="14" 
                                       Foreground="#666"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
