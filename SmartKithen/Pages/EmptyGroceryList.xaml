<Page x:Class="SmartKithen.Pages.EmptyGroceryList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmartKithen.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="EmptyGroceryList"
      Background="#FFF8FC">

    <Grid>
        <!-- Определения строк должны быть сразу после открывающего тега Grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Фон с градиентом -->
        <Rectangle Grid.RowSpan="2">
            <!-- Добавлено Grid.RowSpan чтобы фон покрывал все строки -->
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="White" 
                Height="60" 
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <Button Grid.Column="0"
                        Content="← Назад"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#1A5D34"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <!-- Title -->
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="📦"
                                FontSize="18"
                                HorizontalAlignment="Center"/>
                    <TextBlock Text="Мои продукты"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#1A5D34" Width="115"/>
                </StackPanel>

                <!-- Add button -->
                <Border Grid.Column="2"
                        Background="#1A5D34"
                        CornerRadius="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                    </Border.Effect>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="12,8"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Добавить" FontSize="13" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,80,0,0">

                <!-- Empty state illustration/icon -->
                <Viewbox Width="120" Height="120">
                    <Grid>
                        <Ellipse Width="100" Height="100" Fill="#F8F9FA"/>
                        <Ellipse Width="80" Height="80" Fill="#FFF8FC"
                                 Stroke="#CFA1C1" StrokeThickness="2" StrokeDashArray="5,3"/>
                        <TextBlock Text="📦"
                                   FontSize="40"
                                   Foreground="#CFA1C1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Viewbox>

                <!-- Empty state title -->
                <TextBlock Text="На кухне пусто"
                           HorizontalAlignment="Center"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1A5D34"
                           Margin="0,10,0,5"/>

                <!-- Empty state description -->
                <TextBlock Text="Добавьте продукты, чтобы отслеживать остатки"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#555"
                           MaxWidth="300"
                           Margin="0,0,0,20"/>

                <!-- Features list -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,0,0,25">
                    <!-- Feature 1 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Ellipse Width="8" Height="8" Fill="#1A5D34" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Добавляйте продукты вручную"
                                   FontSize="14"
                                   Foreground="#333"
                                   FontWeight="Medium"/>
                    </StackPanel>

                    <!-- Feature 2 -->
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#1A5D34" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Импортируйте из рецептов"
                                   FontSize="14"
                                   Foreground="#333"
                                   FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>

                <!-- Add product button -->
                <Border Background="#1A5D34"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="3"/>
                    </Border.Effect>
                    <Button x:Name="AddProductButton"
                            Content="➕ Добавить продукт"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Padding="32,16"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>