<Page x:Class="SmartKithen.Pages.SearchAndFilters"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="SearchAndFilters"
      Background="#FFF8FC"
      MinWidth="600"
      MinHeight="500">

    <Page.Resources>
        <!-- Стиль для основной зеленой кнопки (как кнопка назад) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A5D34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#144528"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для вторичной кнопки (сброс) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1A5D34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#CFA1C1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF0F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек рецептов -->
        <Style x:Key="RecipeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.08" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="BackButton"
                        Content="← Назад"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="15,8"
                        Click="BackButton_Click"/>

                <TextBlock Grid.Column="1"
                           Text="🍳 Поиск рецептов"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#1A5D34"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>

            <!-- Строка поиска (адаптивная) -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="15"
                    Margin="0,0,0,15"
                    BorderThickness="1"
                    BorderBrush="#E0E0E0"
                    Height="45">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="🔍"
                               FontSize="16" 
                               Foreground="#1A5D34"
                               VerticalAlignment="Center"
                               Margin="15,0,10,0"/>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             Padding="0"
                             Foreground="#333"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <Button x:Name="ClearSearchButton"
                            Grid.Column="2"
                            Content="✕"
                            FontSize="16"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#999"
                            Padding="12,0"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            Click="ClearSearchButton_Click"/>
                </Grid>
            </Border>

            <!-- Основной контент (адаптивный) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="250" MaxWidth="300"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Панель фильтров -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="20"
                        Padding="15"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0"
                        VerticalAlignment="Stretch"
                        MaxWidth="300"
                        MinWidth="250">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalAlignment="Stretch">
                        <!-- Растягиваем ScrollViewer -->
                        <StackPanel Orientation="Vertical">

                            <TextBlock Text="Фильтры"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#1A5D34"
                       Margin="0,0,0,10"/>

                            <!-- Время приготовления -->
                            <TextBlock Text="⏱️ Время приготовления"
                       FontSize="14" FontWeight="Medium"
                       Foreground="#333"
                       Margin="0,0,0,10"/>

                            <CheckBox x:Name="Time30CheckBox"
                      Content="До 30 минут"
                      FontSize="13" Foreground="#555"
                      Margin="0,0,0,8"
                      Checked="FilterChanged"
                      Unchecked="FilterChanged"/>

                            <CheckBox x:Name="Time3060CheckBox"
                      Content="30–60 минут"
                      FontSize="13" Foreground="#555"
                      Margin="0,0,0,8"
                      Checked="FilterChanged"
                      Unchecked="FilterChanged"/>

                            <CheckBox x:Name="Time60CheckBox"
                      Content="Более 60 минут"
                      FontSize="13" Foreground="#555"
                      Margin="0,0,0,18"
                      Checked="FilterChanged"
                      Unchecked="FilterChanged"/>

                            <!-- Категории из БД -->
                            <TextBlock Text="🍽️ Категория"
                       FontSize="14" FontWeight="Medium"
                       Foreground="#333"
                       Margin="0,0,0,10"/>

                            <!-- Список категорий — динамический -->
                            <StackPanel x:Name="CategoriesPanel"
                        Orientation="Vertical"
                        Margin="0,0,0,0"/>

                            <!-- Кнопки всегда внизу панели -->
                            <StackPanel Orientation="Vertical"
                        Margin="0,10,0,0">
                                <Button x:Name="ApplyFiltersButton"
                        Content="Применить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,0,8"
                        Click="ApplyFiltersButton_Click"/>

                                <Button x:Name="ResetFiltersButton"
                        Content="Сбросить"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ResetFiltersButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Результаты (адаптивные) -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок результатов -->
                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
                        <TextBlock x:Name="SearchQueryText"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1A5D34"
                                   Text="Все рецепты"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock x:Name="ResultsCountText"
                                   FontSize="12"
                                   Foreground="#666"/>
                    </StackPanel>

                    <!-- Скролл с карточками (адаптивный WrapPanel) -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="ResultsPanel"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Left"/>
                    </ScrollViewer>

                    <!-- Заглушка если ничего не найдено -->
                    <Border x:Name="EmptyState"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Background="White"
                            CornerRadius="20"
                            Padding="30,50"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="400">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="😕" FontSize="64"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,20"/>
                            <TextBlock x:Name="EmptyStateText"
                                       Text="Ничего не найдено"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="#1A5D34"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Попробуйте изменить параметры поиска"
                                       FontSize="14" Foreground="#666"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>