<Page x:Class="SmartKithen.Pages.SearchAndFilters"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="SearchAndFilters"
      Background="#FFF8FC">

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        FontSize="14"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#1A5D34"
                        Padding="10,5"
                        Click="BackButton_Click"/>

                <TextBlock Grid.Column="1"
                           Text="Поиск рецептов"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#1A5D34"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Строка поиска -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="15"
                    Margin="0,0,0,20"
                    Padding="5"
                    BorderThickness="1"
                    BorderBrush="#E0E0E0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="🔍"
                               FontSize="16" Foreground="#666"
                               VerticalAlignment="Center"
                               Margin="15,0,10,0"/>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             Padding="0,10"
                             Foreground="#333"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <Button x:Name="ClearSearchButton"
                            Grid.Column="2"
                            Content="×"
                            FontSize="20"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#999"
                            Padding="12,5"
                            Visibility="Collapsed"
                            Click="ClearSearchButton_Click"/>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Панель фильтров -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="20"
                        Padding="25"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0"
                        VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>
                    
                    
                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="Фильтры"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#1A5D34"
                                   Margin="0,0,0,20"/>

                        <!-- Время приготовления -->
                        <TextBlock Text="⏱️ Время приготовления"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="#333"
                                   Margin="0,0,0,12"/>

                        <CheckBox x:Name="Time30CheckBox"
                                  Content="До 30 мин"
                                  FontSize="13" Foreground="#555"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="Time3060CheckBox"
                                  Content="30–60 мин"
                                  FontSize="13" Foreground="#555"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="Time60CheckBox"
                                  Content="Более 60 мин"
                                  FontSize="13" Foreground="#555"
                                  Margin="0,0,0,25"/>

                        <!-- Сложность -->
                        <TextBlock Text="⚡ Сложность"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="#333"
                                   Margin="0,0,0,12"/>

                        <CheckBox x:Name="DifficultyEasyCheckBox"
                                  Content="Простая (до 30 мин)"
                                  FontSize="13" Foreground="#555"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="DifficultyMediumCheckBox"
                                  Content="Средняя (30–60 мин)"
                                  FontSize="13" Foreground="#555"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="DifficultyHardCheckBox"
                                  Content="Сложная (более 60 мин)"
                                  FontSize="13" Foreground="#555"
                                  Margin="0,0,0,25"/>

                        <!-- Категории из БД -->
                        <TextBlock Text="🍽️ Категория"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="#333"
                                   Margin="0,0,0,12"/>

                        <!-- Список категорий — заполняем динамически -->
                        <StackPanel x:Name="CategoriesPanel"
                                    Orientation="Vertical"
                                    Margin="0,0,0,25"/>

                        <!-- Кнопки -->
                        <Border Background="#1A5D34" CornerRadius="12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="3"/>
                            </Border.Effect>
                            <Button x:Name="ApplyFiltersButton"
                                    Content="Применить"
                                    FontSize="13" FontWeight="Medium"
                                    Background="Transparent"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="20,12"
                                    Click="ApplyFiltersButton_Click"/>
                        </Border>

                        <Border BorderBrush="#CFA1C1" BorderThickness="2" CornerRadius="12">
                            <Button x:Name="ResetFiltersButton"
                                    Content="Сбросить"
                                    FontSize="13" FontWeight="Medium"
                                    Background="Transparent"
                                    Foreground="#1A5D34"
                                    BorderThickness="0"
                                    Padding="20,12"
                                    Click="ResetFiltersButton_Click"/>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Результаты -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок результатов -->
                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,15">
                        <TextBlock x:Name="SearchQueryText"
                                   FontSize="16" FontWeight="Medium"
                                   Foreground="#1A5D34"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="ResultsCountText"
                                   FontSize="13"
                                   Foreground="#666"/>
                    </StackPanel>

                    <!-- Скролл с карточками -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ResultsPanel"
                                   Orientation="Horizontal"/>
                    </ScrollViewer>

                    <!-- Заглушка если ничего не найдено -->
                    <Border x:Name="EmptyState"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Background="White"
                            CornerRadius="20"
                            Padding="40">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="48"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,15"/>
                            <TextBlock x:Name="EmptyStateText"
                                       Text="Ничего не найдено"
                                       FontSize="16" Foreground="#999"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>