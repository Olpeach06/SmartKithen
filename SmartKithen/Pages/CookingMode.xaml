<Page x:Class="SmartKithen.Pages.CookingMode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmartKithen.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="800"
      Title="CookingMode"
      Background="#FFF8FC">

    <Page.Resources>
        <!-- Стиль для основных кнопок -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF0F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для навигационных кнопок -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A5D34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A7A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для таймера -->
        <Style x:Key="TimerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A5D34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" Opacity="0.1" ShadowDepth="1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A7A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Фон с градиентом -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="20">

                <!-- Шапка -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка закрытия -->
                    <Button x:Name="CloseButton"
                            Grid.Column="0"
                            Style="{StaticResource MainButtonStyle}"
                            Click="CloseButton_Click">
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="15,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="←" 
                                           FontSize="18" 
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Закрыть" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#1A5D34"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Прогресс -->
                    <Border Grid.Column="2"
                            Background="White" 
                            CornerRadius="15" 
                            Padding="20,15"
                            HorizontalAlignment="Right">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Шаг 3 из 8" 
                                       FontSize="14" 
                                       Foreground="#666"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="75%" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#1A5D34"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Основной контент -->
                <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center" 
                            Margin="0,40,0,0">

                    <!-- Номер шага -->
                    <Border Background="#1A5D34" 
                            CornerRadius="15" 
                            Padding="30,20"
                            Margin="0,0,0,30"
                            Width="200">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.15" ShadowDepth="3"/>
                        </Border.Effect>
                        <TextBlock Text="ШАГ 3" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Описание шага -->
                    <Border Background="White" 
                            CornerRadius="15" 
                            Padding="30"
                            Margin="0,0,0,30"
                            Width="500"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <TextBlock Text="Добавьте сливки к бекону и тушите на медленном огне 5 минут" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="#333"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="28"/>
                    </Border>

                    <!-- Таймер -->
                    <Border Background="White" 
                            CornerRadius="15" 
                            Padding="30"
                            Margin="0,0,0,30"
                            Width="400"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical" 
                                    HorizontalAlignment="Center">

                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,20">
                                <TextBlock Text="⏰" 
                                           FontSize="24"
                                           Margin="0,0,15,0"
                                           Foreground="#CFA1C1"/>
                                <TextBlock x:Name="TimerText"
                                           Text="05:00" 
                                           FontSize="32" 
                                           FontWeight="Bold" 
                                           Foreground="#1A5D34"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center">
                                <Button x:Name="StartTimerButton"
                                        Content="▶" 
                                        Style="{StaticResource TimerButtonStyle}"
                                        Width="80"
                                        Margin="0,0,15,0"
                                        Click="StartTimerButton_Click"/>

                                <Button x:Name="PauseTimerButton"
                                        Content="⏸" 
                                        Style="{StaticResource TimerButtonStyle}"
                                        Width="80"
                                        Background="#CFA1C1"
                                        Click="PauseTimerButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Ингредиенты для шага -->
                    <Border Background="White" 
                            CornerRadius="15" 
                            Padding="25"
                            Margin="0,0,0,40"
                            Width="500"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical">

                            <TextBlock Text="Ингредиенты для этого шага:" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1A5D34"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левый ингредиент -->
                                <Border Grid.Column="0"
                                        Background="#FFF8FC" 
                                        CornerRadius="10" 
                                        Padding="20"
                                        Margin="5"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Vertical" 
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="🥛" 
                                                   FontSize="28"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Сливки" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#1A5D34"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="200 мл" 
                                                   FontSize="14" 
                                                   Foreground="#666"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Плюсик -->
                                <TextBlock Grid.Column="1"
                                           Text="+" 
                                           FontSize="24" 
                                           FontWeight="Bold" 
                                           Foreground="#CFA1C1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="20,0"/>

                                <!-- Правый ингредиент -->
                                <Border Grid.Column="2"
                                        Background="#FFF8FC" 
                                        CornerRadius="10" 
                                        Padding="20"
                                        Margin="5"
                                        BorderBrush="#CFA1C1"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Vertical" 
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="🥓" 
                                                   FontSize="28"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Бекон" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#1A5D34"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="200 г" 
                                                   FontSize="14" 
                                                   Foreground="#666"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Кнопки навигации -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,0,0,40">

                        <Button x:Name="BackButton"
                                Content="← Назад" 
                                Style="{StaticResource NavigationButtonStyle}"
                                Background="White"
                                Foreground="#1A5D34"
                                BorderBrush="#1A5D34"
                                BorderThickness="1"
                                Margin="0,0,15,0"
                                Click="BackButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="PauseButton"
                                Content="⏸ Пауза" 
                                Style="{StaticResource NavigationButtonStyle}"
                                Background="#CFA1C1"
                                Foreground="White"
                                Margin="0,0,15,0"
                                Click="PauseButton_Click"/>

                        <Button x:Name="NextButton"
                                Content="Далее →" 
                                Style="{StaticResource NavigationButtonStyle}"
                                Click="NextButton_Click"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
