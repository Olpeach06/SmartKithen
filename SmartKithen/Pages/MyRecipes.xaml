<Page x:Class="SmartKithen.Pages.MyRecipes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="MyRecipes"
      Background="#FFF8FC">

    <Page.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A5D34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="3"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#144528"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A5D34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8FC" Offset="0"/>
                    <GradientStop Color="#FFAC6586" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="20">

                <!-- Шапка -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="15" 
                            Padding="15,10" HorizontalAlignment="Left">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🍳" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Smart Kitchen" FontSize="18" FontWeight="Bold" 
                                       Foreground="#1A5D34" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Поиск -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12"
                            Padding="15,10" Margin="20,0" VerticalAlignment="Center"
                            Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,10,0"
                                       VerticalAlignment="Center" Foreground="#666"/>
                            <TextBox x:Name="SearchBox"
                                     FontSize="14" Foreground="#999"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" Width="200"
                                     Text="Поиск..."
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     TextChanged="SearchBox_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="White" CornerRadius="10" Padding="10"
                                Margin="0,0,10,0" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <TextBlock Text="⚙️" FontSize="16" Foreground="#1A5D34"/>
                        </Border>

                        <Border Background="#1A5D34" CornerRadius="12" 
                                Padding="12,8" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="12" Margin="0,0,8,0" Foreground="White"/>
                                <TextBlock x:Name="HeaderUserName"
                                           Text="..." FontSize="12" 
                                           Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="AddRecipeButton"
                                Content="+ Добавить рецепт" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="12" Padding="15,10"
                                Click="AddRecipeButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Заголовок и фильтры -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Мои рецепты" 
                               FontSize="22" FontWeight="Bold" 
                               Foreground="#1A5D34" VerticalAlignment="Center"/>

                    <!-- Счётчик -->
                    <TextBlock Grid.Column="1"
                               x:Name="RecipesCountText"
                               FontSize="13" Foreground="#999"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>

                    <!-- Категории фильтр -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8"
                            Padding="5" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>
                        <ComboBox x:Name="CategoryFilter"
                                  FontSize="13" BorderThickness="0"
                                  Background="Transparent" Padding="10,6"
                                  SelectionChanged="CategoryFilter_SelectionChanged"/>
                    </Border>

                    <Button Grid.Column="3"
                            Content="Сортировка ▼" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            x:Name="SortButton"
                            Margin="0,0,10,0"
                            Click="SortButton_Click"/>

                    <Button Grid.Column="4"
                            x:Name="BackButton"
                            Content="← Назад" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BackButton_Click"/>
                </Grid>

                <!-- Динамическая сетка рецептов -->
                <WrapPanel x:Name="RecipesPanel"
                           Orientation="Horizontal"
                           HorizontalAlignment="Stretch"
                           Margin="0,0,0,25"/>

                <!-- Заглушка если пусто -->
                <Border x:Name="EmptyState" Visibility="Collapsed"
                        Background="White" CornerRadius="20" Padding="40">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="🍽️" FontSize="48"
                                   HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock x:Name="EmptyStateText"
                                   Text="Рецептов пока нет"
                                   FontSize="16" Foreground="#999"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Кнопка загрузки ещё -->
                <Button x:Name="LoadMoreButton"
                        Content="Загрузить ещё" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="20,12"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Click="LoadMoreButton_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>